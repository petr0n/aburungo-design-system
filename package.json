{
  "name": "aburungo-design-system",
  "version": "0.1.0",
  "description": "AburunGo component library \u2014 design tokens, primitives, and domain components",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./lib": {
      "import": "./dist/lib.js",
      "types": "./dist/lib.d.ts"
    },
    "./src/tokens.css": {
      "style": "./src/tokens.css",
      "default": "./src/tokens.css"
    },
    "./src/brand.css": {
      "style": "./src/brand.css",
      "default": "./src/brand.css"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/index.css",
    "src/tokens.css",
    "src/brand.css"
  ],
  "scripts": {
    "check:brand": "node scripts/check-forbidden-assets.mjs",
    "check:adherence": "node scripts/check-adherence.mjs",
    "lint": "oxlint --config .oxlintrc.json src/ && pnpm check:adherence && pnpm check:contrast",
    "build": "pnpm check:brand && pnpm lint && tsup && pnpm build:tokens",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup",
    "build:tokens": "node scripts/build-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "impeccable": "^3.5.0",
    "oxlint": "^1.77.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
