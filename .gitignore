node_modules/
dist/*
# ...except the generated token sheet. colors_and_type.css imports it, so the
# 27 preview pages render unstyled from a fresh clone without it. They are
# static HTML served over http.server with no build step -- requiring a build
# first would defeat the point of having them.
!dist/tokens.plain.css
*.tsbuildinfo
.DS_Store

*.afdesign\~lock\~

# Third-party design skills. Kept on disk, out of the repo — each is
# regenerated by its own installer, so tracking them would vendor ~6MB of
# someone else's source. Reinstall with:
#   npx impeccable install          -> .claude/skills/impeccable, .github/*
#   npx skills add <taste-skill>    -> .agents/skills (see skills-lock.json)
# frontend-design is the exception: hand-copied from the marketplace cache
# per plan task 0.5, so it is tracked.
.agents/
.claude/skills/*
!.claude/skills/frontend-design/
.github/agents/
.github/hooks/
.github/skills/
